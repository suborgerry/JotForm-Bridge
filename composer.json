{
    "name": "jotform-bridge/jotform-bridge",
    "description": "Development harness for the Jotform Bridge WordPress plugin. Not shipped with the release ZIP.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "JotformBridge\\": "jotform-bridge/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JotformBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "hooks": "php bin/generate-hooks.php",
        "hooks:check": "php bin/generate-hooks.php --check",
        "version": "php bin/version.php",
        "version:check": "php bin/version.php --check",
        "check": [
            "@lint",
            "@hooks:check",
            "@version:check",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "lint": "Check the plugin against phpcs.xml.dist.",
        "lint:fix": "Apply the fixes phpcs can make on its own.",
        "hooks": "Regenerate HOOKS.md from the docblocks in src/.",
        "hooks:check": "Fail if HOOKS.md no longer matches the source.",
        "check": "Everything CI runs: lint, hooks, then tests."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
