# Composer. composer.lock is deliberately NOT ignored: this repository is an
# application, not a library, so the versions the suite runs against are part
# of the record.
/vendor/
/jotform-bridge/vendor/

# Node (dev tooling only, never required in production)
/node_modules/

# Tests and coverage
/.playwright-mcp/
/.phpunit.result.cache
/coverage/
/tests/_output/

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
secrets.json
/.local/

# Release build
/build/
/dist/
*.zip

# WordPress runtime (in case a local installation ends up alongside)
wp-config.php
/wp-content/
/wordpress/

# The WordPress the integration suite runs against. Downloaded by
# bin/install-wp.sh, never committed: it is 40 MB of somebody else's code plus
# a SQLite database, and the plugin is symlinked into it rather than copied, so
# there is nothing in here that is not reproducible from one command.
/.wordpress/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
