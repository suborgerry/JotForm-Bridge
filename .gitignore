# Composer. composer.lock is deliberately NOT ignored: this repository is an
# application, not a library, so the versions the suite runs against are part
# of the record.
/vendor/
/jotform-bridge/vendor/

# Node (dev tooling only, never required in production)
/node_modules/

# Tests and coverage
/.phpunit.result.cache
/coverage/
/tests/_output/

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
secrets.json
/.local/

# Release build
/build/
/dist/
*.zip

# WordPress runtime (in case a local installation ends up alongside)
wp-config.php
/wp-content/
/wordpress/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
