# Static analysis of the shipped plugin.
#
# This is the second analyser, and it is narrow for the same reason
# phpcs.xml.dist is: what is enabled here is what can catch a defect, and
# everything switched off says why. A linter whose output has to be ignored
# teaches people to ignore linter output.
#
# The two barely overlap, which is the argument for having both. PHPCS reads
# the shape of the source — escaping, nonces, prefixes, the text domain, the
# style — and does not know what a variable holds. PHPStan reads types across
# call boundaries: a value that can be null reaching a parameter that cannot
# take it, and a docblock that no longer describes the code under it.
#
# The first run, in August 2026, found four real defects on 12,349 lines.
# Neither PHPCS nor any of the 533 tests could see one of them, and the worst
# was a leftover from a removal: Plugin::quota() still passed Settings to a
# QuotaGuard whose constructor had been deleted with the account quota
# tracking, and PHP discards an argument to a class that has no constructor
# without a word. Every other call site, tests included, already said
# `new QuotaGuard()`, so nothing failed and nothing could have.
#
# Level 8 rather than 6: the array shapes this codebase documents are checked
# at 8 and not at 6, and half the real findings were exactly that. Level 9 was
# measured and rejected — 310 findings, overwhelmingly about the `mixed`
# WordPress hands back by definition.

parameters:
    level: 8

    # Only the plugin. The rest of the repository is development scaffolding
    # that never ships, and the tests answer to PHPUnit's conventions.
    paths:
        - jotform-bridge/src
        - jotform-bridge/jotform-bridge.php
        - jotform-bridge/uninstall.php

    # The floor in the plugin header. The two move together.
    phpVersion: 80000

    bootstrapFiles:
        - bin/phpstan-bootstrap.php

    ignoreErrors:
        # A filter's return value is not the type its docblock describes.
        #
        # phpstan-wordpress types apply_filters() from the @param tags above
        # the call — and those document what the plugin passes *in*. What comes
        # back is whatever a third-party callback returned, which is the entire
        # point of a filter. So PHPStan reads the is_array() and is_string()
        # guards on those return values as dead code, when they are the only
        # thing between another plugin's mistake and a fatal error in ours.
        # The convention that feeds it the wrong answer is our own: those
        # @param tags exist because bin/generate-hooks.php requires them.
        #
        # The same argument covers get_sites(), whose stub promises an array,
        # and the Jotform API payloads, whose shape is asserted by a docblock
        # this plugin wrote about data it does not control.
        #
        # Eleven of the twenty-seven findings in the first run were these, and
        # every one sat on a trust boundary. The price of switching the two
        # rules off is one genuinely redundant check, on token_get_all() in
        # TemplateScanner::withoutPhpComments(), which is left alone.
        -
            identifier: function.alreadyNarrowedType
        -
            identifier: instanceof.alwaysTrue

        # An admin view is included inside the method that renders it, so its
        # $this — and the variables that method prepared — are defined at
        # runtime. A static analyser reading the file on its own cannot see
        # that. The views stay under analysis for everything else rather than
        # being excluded, which costs one suppressed rule instead of all of
        # them.
        -
            identifier: variable.undefined
            path: jotform-bridge/src/Admin/views/*

        # str_contains() and str_ends_with() accept any string as the haystack:
        # an empty one is legal and answers false. PHPStan's signature for both
        # declares non-empty-string, which is wrong, and does so at every
        # phpVersion from 8.0 to 8.4 — measured, not assumed.
        -
            message: '#^Parameter \#1 \$haystack of function str_(contains|ends_with) expects non-empty-string, string given\.$#'

        # Called from the two admin views, through the $this the rule above is
        # about. Reported unused; it is not. Deliberately not silenced by
        # making the method public: the rule's job is to find private methods
        # nothing calls, and it keeps doing that everywhere else in the class.
        -
            message: '#^Method JotformBridge\\Admin\\IntegrationsPage::formatDateTime\(\) is unused\.$#'
            path: jotform-bridge/src/Admin/IntegrationsPage.php
