# Copy to .env and fill in. The .env file is never committed.

# The Jotform API key for local development and Test Connection.
JOTFORM_API_KEY=

# The Jotform API base URL. Standard: https://api.jotform.com
# EU: https://eu-api.jotform.com
JOTFORM_API_BASE_URL=https://api.jotform.com

# The ID of the form that may be used for write tests.
# Leave empty when there is no such form — live submissions are then forbidden.
JOTFORM_TEST_FORM_ID=
