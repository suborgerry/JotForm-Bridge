# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.

# Jotform API key для локальной разработки и Test Connection.
JOTFORM_API_KEY=

# Base URL Jotform API. Standard: https://api.jotform.com
# EU: https://eu-api.jotform.com
JOTFORM_API_BASE_URL=https://api.jotform.com

# ID формы, которую разрешено использовать для write-тестов.
# Оставить пустым, если такой формы нет — тогда live submissions запрещены.
JOTFORM_TEST_FORM_ID=
